import {Image} from 'astro:assets';
import ospreyIcon from '../assets/osprey-icon.png';

const links = [
    {
        href: '/download/',
        label: 'Download'
    },
    {
        href: '/check/',
        label: 'Website Safety Checker',
        isNew: true
    },
];
---

<header class="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="/">
            <Image
                    src={ospreyIcon}
                    alt="Osprey's Icon"
                    title="Osprey"
                    width={32}
                    height={32}
                    densities={[1, 2]}
                    loading="eager"
                    fetchpriority="high"
            />
            <span>Osprey</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
            {links.map((link) => (
                    <a href={link.href} class={link.isNew ? 'has-badge' : ''}>
                        {link.label}
                        {link.isNew && <span class="badge-new">NEW</span>}
                    </a>
            ))}

            <div class="nav-icons">
                <a
                        class="support-link"
                        href="https://ko-fi.com/ospreyproject"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Support Osprey on Ko-fi"
                        title="Support Osprey on Ko-fi"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                </a>

                <a
                        class="console-link"
                        href="https://console.osprey.ac"
                        aria-label="Sign in to the Osprey Console"
                        title="Sign in to the Osprey Console"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/>
                    </svg>
                </a>

                <button type="button"
                        class="theme-toggle"
                        title="Toggle light/dark theme"
                        aria-label="Toggle light/dark theme">
                    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
                    </svg>
                    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24"
                         fill="currentColor" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/>
                    </svg>
                </button>
            </div>
        </nav>
    </div>
</header>
