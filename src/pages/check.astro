    {
        id: 'validin',
        name: 'Validin',
        icon: 'validin',
        group: 'Threat Feeds',
        url: 'https://validin.com/?utm_source=osprey'
    },
];

const groups = ['Official Partners', 'DNS Servers', 'Threat Feeds'];

const title = 'Check a URL for Malware, Phishing & Scams';
const description =
    'Scan any website or link for malware, phishing, scams, and other threats. Osprey\'s free URL checker shows if a site is safe to open, with no account required.';

const faqs = [
    {
        q: 'How do I check if a website or link is safe?',
        a: 'Paste the full address into the box above and select Scan. Osprey checks the link against the same phishing, malware, and scam sources it uses to protect your browser, then shows what each provider reports. If every provider returns a clean result, the site is very likely safe to open. If one or more flag it, treat the link with caution.',
    },
    {
        q: 'Can I scan a URL for viruses and malware?',
        a: 'Yes. The scanner checks each URL against threat feeds and reputation services that track malware, malicious downloads, and compromised sites. A flagged result means at least one provider considers the page dangerous, so you should avoid it. This checks the address and its reputation, not the contents of a file you have already downloaded.',
    },
    {
        q: 'How do I tell if a link is phishing or a scam?',
        a: 'Phishing and scam pages are often brand new and built to imitate a real login page or store. Osprey checks anti-phishing feeds and newly registered domain lists, so a link that copies your bank or a shop is more likely to be flagged here. A clean result is not a guarantee, so still read the address bar carefully and never enter passwords on a page you reached from an unexpected message.',
    },
    {
        q: 'How does Osprey check a website\'s reputation?',
        a: 'Each scan asks every security provider listed above, including official partners, public DNS filters, and open threat feeds, whether they have seen the domain used for anything harmful. Their combined answer is the site\'s reputation. Because the check runs through Osprey\'s proxy, the providers only see the proxy rather than you.',
    },
    {
        q: 'How is this different from VirusTotal?',
        a: 'VirusTotal is a broad aggregator of antivirus engines and is well suited to inspecting files and URLs in depth. Osprey\'s checker is narrower by design: it runs the exact set of URL and domain providers that block sites live in your browser, so a result here tells you how Osprey itself would treat the page. It is free, needs no account, and does not log your browsing.',
    },
    {
        q: 'Is the URL scanner free?',
        a: 'Yes. Checking a link is completely free and does not require an account or any personal details. It uses the same protection that ships with the free, open-source Osprey extension.',
    },
];

const schema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebApplication',
            '@id': 'https://osprey.ac/check/#app',
            name: 'Osprey URL Checker',
            alternateName: 'Osprey Link & Website Safety Checker',
            applicationCategory: 'SecurityApplication',
            applicationSubCategory: 'URL Scanner',
            operatingSystem: 'Any',
            url: 'https://osprey.ac/check/',
            description:
                'Free tool to scan any website or link for phishing, malware, scams, and other threats using the same security providers as the Osprey browser extension.',
            isAccessibleForFree: true,
            browserRequirements: 'Requires JavaScript.',
            featureList: [
                'Check a URL for malware and viruses',
                'Check a link for phishing and scams',
                'See if a website is safe before you open it',
                'Website reputation from multiple security providers',
                'Free with no account required',
            ],
            offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
            isPartOf: {'@id': 'https://osprey.ac/#software'},
        },
        {
            '@type': 'FAQPage',
            '@id': 'https://osprey.ac/check/#faq',
            mainEntity: faqs.map((faq) => ({
                '@type': 'Question',
                name: faq.q,
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: faq.a,
                },
            })),
        },
    ],
};
---

<Base title={title} description={description} schema={schema}>
    <link rel="preconnect" href="https://challenges.cloudflare.com"/>
    <script is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
    ></script>

    <section class="check-head">
        <h1>Check a URL</h1>
        <p class="lede">
            Scan any website or link for malware, phishing, scams, and other threats.
            <br>
            The <a href="/download/" class="contact-link">Osprey extension</a> does this for you automatically in
            real-time.
        </p>
    </section>

    <form id="scan-form" class="scan-form" novalidate>
        <label class="sr-only" for="url-input">URL to scan</label>
        <div class="scan-row">
            <input
                    id="url-input"
                    class="url-input"
                    type="url"
                    name="url"
                    inputmode="url"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    placeholder="https://example.com"
                    aria-describedby="scan-error"
            />
            <button id="scan-button" class="install-btn scan-button" type="submit" disabled>
                Scan
            </button>
        </div>

        <p id="scan-error" class="scan-error" role="alert" hidden></p>
        <p id="captcha-note" class="captcha-note" role="status" hidden></p>

        <p class="scan-terms">
            By scanning a URL, you agree to our <a href="/privacy/" class="contact-link">Privacy Policy
        </a> and <a href="/terms/" class="contact-link">Terms of Service</a>.
        </p>

        <div
                id="cf-turnstile"
                class="cf-turnstile"
                data-sitekey="0x4AAAAAAEIwxP1XUsXc5UsE"
                data-size="normal"
                data-theme="auto"
                data-callback="onSuccess"
                data-expired-callback="onExpired"
        ></div>
    </form>

    <section id="summary" class="summary" hidden aria-live="polite">
        <span id="summary-badge" class="summary-badge"></span>
        <span id="summary-text" class="summary-text"></span>
        <span id="summary-url" class="summary-url"></span>
    </section>

    <section id="results" class="results" aria-label="Provider results" hidden>
        {groups.map((group) => (
                <div class="result-group" data-group={group}>
                    <h2 class="group-title">{group}</h2>
                    <ul class="provider-grid">
                        {providers.filter((p) => p.group === group).map((p) => (
                                <li class="provider-card" data-provider={p.id} data-state="idle">
                                    <img class="provider-logo" src={logo(p.icon)} alt="" width="28" height="28"
                                         loading="lazy"/>
                                    <a class="provider-name" href={p.url} target="_blank"
                                       rel="noopener noreferrer">{p.name}</a>
                                    <span class="provider-status">
                                        <span class="status-dot"></span>
                                        <span class="status-label">Idle</span>
                                    </span>
                                </li>
                        ))}
                    </ul>
                </div>
        ))}
    </section>

    <p id="disclaimer" class="disclaimer" hidden>
        Verdicts are provided by third party security vendors and may be cached for a short time.
        A clean result is not a guarantee of safety. If you believe a verdict is wrong, use the
        report option inside the Osprey extension to contact the relevant provider.
    </p>

    <section class="band">
        <h2 class="band-title">Common questions</h2>
        <div class="check-faq">
            {
                faqs.map((faq) => (
                        <details class="faq">
                            <summary>{faq.q}</summary>
                            <p>{faq.a}</p>
                        </details>
                ))
            }
        </div>
    </section>

    <section class="band">
        <h2 class="band-title">Something not working?</h2>
        <div class="prose">
            <p class="band-sub">
                Email <a href="mailto:support@osprey.ac">support@osprey.ac</a> or create an issue
                on <a href="https://github.com/OspreyProject/Osprey/issues/new/choose"
                      aria-label="Create an issue on GitHub">GitHub</a>.
                <br>
                We'll get back to you as soon as we can.
            </p>
        </div>
    </section>

    <script is:inline data-cfasync="false">
        // Global variables for Turnstile state
        let captchaToken = '';

        // Expose callbacks globally so the Turnstile iframe can reach them
        window.onSuccess = function (token) {
            captchaToken = token;
            const captchaNote = document.getElementById('captcha-note');

            if (captchaNote) {
                captchaNote.hidden = true;
                captchaNote.textContent = '';
            }
        };

        window.onExpired = function () {
            captchaToken = '';
        };

        (function () {
            // The single backend aggregator endpoint. The page never calls the
            // individual provider endpoints directly. The backend verifies the
            // captcha, rate limits, caches, and fans out server side.
            const endpoint = 'https://api.osprey.ac/check';

            const form = document.getElementById('scan-form');
            const input = document.getElementById('url-input');
            const button = document.getElementById('scan-button');
            const errorEl = document.getElementById('scan-error');
            const summary = document.getElementById('summary');
            const summaryBadge = document.getElementById('summary-badge');
            const summaryText = document.getElementById('summary-text');
            const summaryUrl = document.getElementById('summary-url');
            const captchaNote = document.getElementById('captcha-note');
            const results = document.getElementById('results');
            const disclaimer = document.getElementById('disclaimer');
            const cards = new Map();

            document.querySelectorAll('.provider-card').forEach(function (card) {
                cards.set(card.getAttribute('data-provider'), card);
            });

            // How each provider result string maps to a visible state. These
            // strings match OspreyProtectionResult in the client.
            const states = {
                waiting: {label: 'Waiting', tone: 'waiting'},
                allowed: {label: 'Safe', tone: 'safe'},
                known_safe: {label: 'Safe', tone: 'safe'},
                phishing: {label: 'Phishing', tone: 'danger'},
                malicious: {label: 'Malicious', tone: 'danger'},
                suspicious: {label: 'Suspicious', tone: 'warn'},
                newly_registered: {label: 'Newly Registered', tone: 'warn'},
                dynamic_dns: {label: 'Dynamic DNS', tone: 'warn'},
                failed: {label: 'Unavailable', tone: 'muted'},
                idle: {label: 'Idle', tone: 'idle'},
            };

            const blocking = new Set(['phishing', 'malicious', 'suspicious', 'newly_registered', 'dynamic_dns']);
            let scanning = false;

            function showCaptchaNote(message) {
                captchaNote.textContent = message;
                captchaNote.hidden = false;
            }

            function looksLikeUrl(value) {
                let parsed;

                try {
                    parsed = new URL(value);
                } catch (e) {
                    return false;
                }

                if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
                    return false;
                }

                const host = parsed.hostname.toLowerCase();

                if (!host || host.indexOf('.') === -1) {
                    return false;
                }

                // Reject local and private hosts the same way the client does
                if (host === 'localhost' || host.endsWith('.local')) {
                    return false;
                }

                if (/^\d+\.\d+\.\d+\.\d+$/.test(host)) {
                    const p = host.split('.').map(Number);
                    if (p[0] === 10 || p[0] === 127 || p[0] === 0 ||
                        (p[0] === 169 && p[1] === 254) ||
                        (p[0] === 172 && p[1] >= 16 && p[1] <= 31) ||
                        (p[0] === 192 && p[1] === 168)) {
                        return false;
                    }
                }
                return true;
            }

            function normalizedInput() {
                let value = input.value.trim();

                if (!value) {
                    return '';
                }

                // Allow bare domains by assuming https, matching common scanners
                if (!/^https?:\/\//i.test(value)) {
                    value = 'https://' + value;
                }
                return value;
            }

            function refreshButton() {
                // The button is enabled once the URL is valid. The captcha token is
                // enforced at submit time so a slow or blocked widget never leaves the
                // button permanently greyed out with no explanation.
                button.disabled = scanning || !looksLikeUrl(normalizedInput());
            }

            function showError(message) {
                errorEl.textContent = message;
                errorEl.hidden = false;
            }

            function clearError() {
                errorEl.hidden = true;
                errorEl.textContent = '';
            }

            function setCardState(id, state) {
                const card = cards.get(id);

                if (!card) {
                    return;
                }

                const info = states[state] || states.failed;
                card.setAttribute('data-state', state);
                card.setAttribute('data-tone', info.tone);
                const label = card.querySelector('.status-label');

                if (label) {
                    label.textContent = info.label;
                }
            }

            function resetGrid() {
                cards.forEach(function (card, id) {
                    setCardState(id, 'waiting');
                });
            }

            function updateSummary(flagged, total, finished) {
                summary.hidden = false;

                if (!finished) {
                    summaryBadge.textContent = '...';
                    summaryBadge.setAttribute('data-tone', 'waiting');
                    summaryText.textContent = 'Scanning ' + total + ' security providers';
                    return;
                }

                summaryBadge.textContent = flagged + ' / ' + total;

                if (flagged > 0) {
                    summaryBadge.setAttribute('data-tone', 'danger');
                    summaryText.textContent = flagged === 1
                        ? '1 provider flagged this URL'
                        : flagged + ' providers flagged this URL';
                } else {
                    summaryBadge.setAttribute('data-tone', 'safe');
                    summaryText.textContent = 'No providers flagged this URL';
                }
            }

            function endScan() {
                scanning = false;
                button.textContent = 'Scan';
                refreshButton();
            }

            function handleResult(providerId, result, seen) {
                const state = states[result] ? result : 'failed';
                setCardState(providerId, state);
                seen.add(providerId);
            }

            async function readStream(response, total, seen) {
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let flagged = 0;

                while (true) {
                    const chunk = await reader.read();

                    if (chunk.done) {
                        break;
                    }

                    buffer += decoder.decode(chunk.value, {stream: true});
                    let newline = buffer.indexOf('\n');

                    while (newline !== -1) {
                        const line = buffer.slice(0, newline).trim();
                        buffer = buffer.slice(newline + 1);
                        newline = buffer.indexOf('\n');

                        if (!line) {
                            continue;
                        }

                        let event;

                        try {
                            event = JSON.parse(line);
                        } catch {
                            continue;
                        }

                        if (event.type === 'result') {
                            handleResult(event.provider, event.result, seen);

                            if (blocking.has(event.result)) {
                                flagged++;
                            }

                            updateSummary(flagged, total, false);
                        } else if (event.type === 'error') {
                            showError(event.message || 'The scan could not be completed.');
                        }
                    }
                }
                return flagged;
            }

            async function runScan(url) {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'Accept': 'application/x-ndjson'},
                    body: JSON.stringify({url: url, token: captchaToken}),
                });

                if (response.status === 429) {
                    throw new Error('Too many scans from your network. Please wait a moment and try again.');
                }

                if (response.status === 403) {
                    throw new Error('The captcha could not be verified. Please solve it again.');
                }

                if (response.status === 400) {
                    throw new Error('That URL could not be scanned. Check the address and try again.');
                }

                if (!response.ok || !response.body) {
                    throw new Error('The scan service is unavailable right now. Please try again later.');
                }

                const total = cards.size;
                const seen = new Set();
                const flagged = await readStream(response, total, seen);

                // Any provider that never reported is shown as unavailable
                cards.forEach(function (_card, id) {
                    if (!seen.has(id)) {
                        setCardState(id, 'failed');
                    }
                });

                updateSummary(flagged, total, true);
            }

            input.addEventListener('input', function () {
                clearError();
                refreshButton();
            });

            form.addEventListener('submit', async function (event) {
                event.preventDefault();

                if (scanning) {
                    return;
                }

                const url = normalizedInput();

                if (!looksLikeUrl(url)) {
                    showError('Enter a full http or https URL, for example https://example.com');
                    return;
                }

                // Verify the captcha token is present, throw the captcha note if not.
                if (!captchaToken) {
                    showCaptchaNote('Please wait a moment before scanning this URL.');
                    return;
                }

                clearError();

                scanning = true;
                button.disabled = true;
                button.textContent = 'Scanning';
                input.value = url;
                summaryUrl.textContent = url;

                results.hidden = false;
                disclaimer.hidden = false;

                resetGrid();
                updateSummary(0, cards.size, false);

                try {
                    await runScan(url);
                } catch (err) {
                    showError(err && err.message ? err.message : 'The scan could not be completed.');
                    summary.hidden = true;

                    cards.forEach(function (card, id) {
                        if (card.getAttribute('data-state') === 'waiting') {
                            setCardState(id, 'idle');
                        }
                    });
                } finally {
                    endScan();

                    // Reset the token state and the widget for subsequent scans
                    captchaToken = '';
                    if (window.turnstile) {
                        window.turnstile.reset();
                    }
                }
            });

            refreshButton();
        })();
    </script>
</Base>
