import Base from '../layouts/Base.astro';
import CheckTool from '../components/CheckTool.astro';
import {faqs} from '../data/providers';

const title = 'Free Website Safety Checker - Malware, Phishing, & Scams';
const description =
    'Scan any URL or link for viruses, malware, and phishing. Osprey\'s free link scanner tool checks website reputation so you can see if a link is safe to open.';

const schema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebApplication',
            '@id': 'https://osprey.ac/check/#app',
            name: 'Osprey Website Safety Checker',
            alternateName: 'Osprey Link & URL Safety Checker',
            applicationCategory: 'SecurityApplication',
            applicationSubCategory: 'URL Scanner',
            operatingSystem: 'Any',
            url: 'https://osprey.ac/check/',
            description:
                'Scan any URL or link for viruses, malware, and phishing. Osprey\'s free link scanner tool checks website reputation so you can see if a link is safe to open.',
            isAccessibleForFree: true,
            browserRequirements: 'Requires JavaScript.',
            featureList: [
                "Check a URL or link for malware and viruses",
                "Check link legitimacy and detect phishing or scams",
                "See if a website is safe before you open it",
                "Website reputation score and security provider reports",
                "Free online link scanner with no account required"
            ],
            offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
            isPartOf: {'@id': 'https://osprey.ac/#software'},
        },
        {
            '@type': 'FAQPage',
            '@id': 'https://osprey.ac/check/#faq',
            mainEntity: faqs.map((faq) => ({
                '@type': 'Question',
                name: faq.q,
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: faq.a,
                },
            })),
        },
    ],
};
---

<Base title={title} description={description} schema={schema}>
    <CheckTool/>
</Base>
