---
import Base from '../layouts/Base.astro';

const logos = import.meta.glob<ImageMetadata>('../assets/providers/*.avif', {
    eager: true,
    import: 'default',
});

const logo = (name: string): string => logos[`../assets/providers/${name}.avif`]?.src ?? '';

const providers = [
    {
        id: 'alphamountain',
        name: 'AlphaMountain',
        icon: 'alphamountain',
        group: 'Official Partners',
        url: 'https://alphamountain.ai/?utm_source=osprey'
    },
    {
        id: 'bforeai',
        name: 'BforeAI PreCrime',
        icon: 'bforeai',
        group: 'Official Partners',
        url: 'https://bfore.ai/?utm_source=osprey'
    },
    {
        id: 'chainpatrol',
        name: 'ChainPatrol',
        icon: 'chainpatrol',
        group: 'Official Partners',
        url: 'https://chainpatrol.io/?utm_source=osprey'
    },
    {
        id: 'izoologic',
        name: 'iZOOlogic',
        icon: 'izoologic',
        group: 'Official Partners',
        url: 'https://izoologic.com/?utm_source=osprey'
    },
    {
        id: 'precisionsec',
        name: 'PrecisionSec',
        icon: 'precisionsec',
        group: 'Official Partners',
        url: 'https://precisionsec.com/?utm_source=osprey'
    },
    {
        id: 'adguard-dns',
