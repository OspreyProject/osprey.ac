---
import Base from '../../layouts/Base.astro';
import CheckTool from '../../components/CheckTool.astro';
import {providers, resultStates, blockingResults} from '../../data/providers';

interface ScanResult {
    url: string;
    host: string;
    primary: string;
    flagged: number;
    total: number;
    results: Record<string, string[]>;
    lastScanned: number;
    firstScanned: number;
}

// Fetches the set of hard-flagged URLs that should have their own crawlable page. Only phishing and
// malicious verdicts reach this feed, so every generated page is a genuine, unique detection rather
// than a thin or auto-spun page. Any failure degrades to zero pages so the site still builds.
export async function getStaticPaths() {
    const feedUrl = import.meta.env.SCAN_FEED_URL;
    const feedToken = import.meta.env.SCAN_FEED_TOKEN;

    if (!feedUrl || !feedToken) {
        return [];
    }

    try {
        const response = await fetch(feedUrl, {
            headers: {'Authorization': `Bearer ${feedToken}`, 'Accept': 'application/json'},
        });

        if (!response.ok) {
            return [];
        }

        const body = await response.json();
        const records: ScanResult[] = Array.isArray(body?.results) ? body.results : [];

        return records
            .filter((record) => typeof record?.url === 'string' && record.url.startsWith('https://'))
            .map((record) => ({
                params: {target: record.url.slice('https://'.length)},
                props: {record},
            }));
    } catch {
        return [];
    }
}

const {record} = Astro.props;

const stateFor = (id: string): string => {
    const values = record.results?.[id];
    return values && values.length && resultStates[values[0]] ? values[0] : 'failed';
};

const primaryLabel = resultStates[record.primary]?.label ?? 'Flagged';

const flaggingProviders = providers
    .filter((p) => blockingResults.includes(stateFor(p.id)))
    .map((p) => p.name);

const target = record.url.slice('https://'.length);
const canonicalPath = `/check/${target}/`;

const title = `Safety Result for: ${target}`;
const description = `${record.flagged} of ${record.total} security providers flagged ${target} as ${primaryLabel.toLowerCase()}. `
    + `See which vendors reported it and when it was last checked.`;

const schema = {
    '@graph': [
        {
            '@type': 'WebPage',
            '@id': `https://osprey.ac${canonicalPath}#page`,
            url: `https://osprey.ac${canonicalPath}`,
            name: title,
            description,
            dateModified: new Date(record.lastScanned).toISOString(),
            isPartOf: {'@id': 'https://osprey.ac/#website'},
            about: {'@type': 'Thing', name: record.url},
        },
        {
            '@type': 'BreadcrumbList',
            '@id': `https://osprey.ac${canonicalPath}#breadcrumb`,
            itemListElement: [
                {'@type': 'ListItem', position: 1, name: 'Link checker', item: 'https://osprey.ac/check/'},
                {'@type': 'ListItem', position: 2, name: target, item: `https://osprey.ac${canonicalPath}`},
            ],
        },
    ],
};
---

<Base title={title} description={description} schema={schema} canonicalPath={canonicalPath}>
    <CheckTool result={{
        url: record.url,
        results: record.results,
        total: record.total,
        lastScanned: record.lastScanned,
    }}/>
</Base>
