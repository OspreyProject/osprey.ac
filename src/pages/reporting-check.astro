---
import Base from '../layouts/Base.astro';

const title = 'Reporting Setup Checker – Osprey: Browser Protection';
const description =
    'Verify your Osprey ReportingEndpoint configuration in minutes. Get a temporary test URL, point a pilot endpoint at it, and watch events and heartbeats arrive live.';

// Every check the page runs against received payloads, rendered from this array so the list and
// the validator stay in sync.
const checks = [
    {id: 'heartbeat', label: 'Heartbeat received', detail: 'The extension sends one on startup and every 15 minutes.'},
    {
        id: 'events',
        label: 'Event batch received',
        detail: 'Sent on startup and every 5 minutes when there are detections or overrides to report. Visit a test page like malware.wicar.org, or use the extension normally, to generate one.'
    },
    {
        id: 'deviceTag',
        label: 'DeviceTag is set',
        detail: 'Without it you cannot tell which machine an event came from.'
    },
    {
        id: 'siteId',
        label: 'SiteId is set',
        detail: 'Without it you cannot tell which client an event came from.'
    },
    {
        id: 'auth',
        label: 'Authorization header present',
        detail: 'Only expected if you set ReportingAuthToken. Your real receiver should reject requests without it.'
    },
    {
        id: 'proxy',
        label: 'Proxy reachable from the endpoint',
        detail: 'The heartbeat probes the configured proxy origin and reports the result.'
    },
];
---

<Base title={title} description={description}>
    <section class="hero">
        <h1>Reporting Setup Checker</h1>
        <p class="hero-sub">
            This page gives you a temporary receiver URL. Point a pilot
            endpoint's <code>ReportingEndpoint</code> policy at it and watch the extension's events and heartbeats
            arrive below, so you know your configuration works before you wire up your own webhook or SIEM.
        </p>
    </section>

    <div class="rc-grid">
        <section class="gen-group" aria-label="Test session">
            <h2 class="rc-heading">1. Your test URL</h2>
            <label class="field">
                <span class="field-label">Receiver base</span>
                <input id="rc-base" class="text-input" type="text" value="https://api.osprey.ac"
                       autocomplete="off" spellcheck="false"/>
                <span class="field-help">Self-hosters can point this at their own OspreyProxy instead.</span>
            </label>
            <label class="field">
                <span class="field-label">Test endpoint URL</span>
                <input id="rc-url" class="text-input" type="text" readonly spellcheck="false"/>
                <span class="field-help">Set this as the <code>ReportingEndpoint</code> policy on a pilot
                    endpoint, through Group Policy, Intune, a plist, or
                    the <a class="contact-link" href="/config-generator/">config generator</a>. Optionally set
                    any <code>ReportingAuthToken</code> to verify the Authorization header arrives too.</span>
            </label>
            <p class="rc-actions">
                <button type="button" id="rc-copy" class="install-btn">Copy URL</button>
                <button type="button" id="rc-sample" class="ghost-btn">Send sample heartbeat</button>
                <button type="button" id="rc-new" class="ghost-btn">New session</button>
            </p>
            <p class="field-help">
                The session holds the last 30 payloads in memory only and expires 30 minutes after the last
                activity. Nothing is stored. Use it to verify configuration, then point your fleet at your
                real receiver.
            </p>
        </section>

        <section class="gen-group" aria-label="Checks">
            <h2 class="rc-heading">2. Checks</h2>
            <p id="rc-status" class="field-help">Waiting for the first payload. This page polls every 4 seconds.</p>
            <ul class="rc-checks">
                {checks.map((c) => (
                        <li class="rc-check" data-check={c.id}>
                            <span class="rc-mark" aria-hidden="true">–</span>
                            <span>
                                <span class="rc-check-label">{c.label}</span>
                                <span class="field-help">{c.detail}</span>
                            </span>
                        </li>
                ))}
            </ul>
        </section>
    </div>

    <section class="gen-group rc-received" aria-label="Received payloads">
        <h2 class="rc-heading">3. Received payloads</h2>
        <div id="rc-list"></div>
    </section>

    <section class="band">
        <h2 class="band-title">Building your real receiver</h2>
        <div class="prose">
            <p class="band-sub">
                Your production receiver only needs to accept a JSON POST and return a 2xx status. Payloads are
                told apart by the top-level <code>kind</code> field, which is either <code>events</code> or
                <code>heartbeat</code>, and every event carries a stable <code>id</code> you should deduplicate
                on. The full payload schema, delivery semantics, and retry behavior are documented in the
                extension repository's <code>docs/outbound-events.md</code>. Alert on a missing heartbeat rather
                than waiting for a removal message, because a removed extension cannot report its own removal.
            </p>
        </div>
    </section>
</Base>

<script is:inline>
    (function () {
        'use strict';

        const pollIntervalMs = 4000;
        const state = {token: '', payloads: [], timer: null, lastError: ''};

        const baseInput = document.getElementById('rc-base');
        const urlInput = document.getElementById('rc-url');
        const statusEl = document.getElementById('rc-status');
        const listEl = document.getElementById('rc-list');

        function newToken() {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') {
                return window.crypto.randomUUID();
            }

            let out = '';
            const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';

            for (let i = 0; i < 32; i++) {
                out += chars[Math.floor(Math.random() * chars.length)];
            }
            return out;
        }

        function endpointUrl() {
            let base = baseInput.value.trim().replace(/\/+$/, '');

            if (!/^https?:\/\//.test(base)) {
                base = 'https://api.osprey.ac';
            }
            return base + '/reporting/test/' + state.token;
        }

        function refreshUrl() {
            urlInput.value = endpointUrl();
        }

        function setStatus(text) {
            statusEl.textContent = text;
        }

        function fmtTime(ms) {
            return new Date(ms).toLocaleTimeString();
        }

        // ---- Checks -----------------------------------------------------------

        function runChecks() {
            const results = {heartbeat: null, events: null, deviceTag: null, siteId: null, auth: null, proxy: null};

            state.payloads.forEach(function (p) {
                const body = p.body || {};

                if (body.kind === 'heartbeat') {
                    results.heartbeat = true;

                    if (typeof body.proxyReachable === 'boolean') {
                        results.proxy = body.proxyReachable;
                    }
                }

                if (body.kind === 'events') {
                    results.events = true;
                }

                if (typeof body.deviceTag === 'string') {
                    results.deviceTag = body.deviceTag.length > 0 ? true : (results.deviceTag || false);
                }

                if (typeof body.siteId === 'string') {
                    results.siteId = body.siteId.length > 0 ? true : (results.siteId || false);
                }

                if (p.authPresent) {
                    results.auth = true;
                } else if (results.auth === null) {
                    results.auth = false;
                }
            });

            document.querySelectorAll('.rc-check').forEach(function (li) {
                const id = li.getAttribute('data-check');
                const mark = li.querySelector('.rc-mark');
                const value = results[id];

                li.classList.remove('rc-pass', 'rc-warn');

                if (value === true) {
                    li.classList.add('rc-pass');
                    mark.textContent = '✓';
                } else if (value === false) {
                    li.classList.add('rc-warn');
                    mark.textContent = '!';
                } else {
                    mark.textContent = '–';
                }
            });
        }

        // ---- Rendering --------------------------------------------------------

        function summarize(p) {
            const body = p.body || {};

            if (body.kind === 'heartbeat') {
                const reach = body.proxyReachable === true ? 'reachable' : 'unreachable';
                return 'Heartbeat. Version ' + (body.version || '?') + ', deviceTag "' + (body.deviceTag || '') +
                    '", siteId "' + (body.siteId || '') + '", proxy ' + (body.proxyOrigin || '?') + ' ' + reach + '.';
            }

            if (body.kind === 'events') {
                const count = Array.isArray(body.events) ? body.events.length : 0;
                let detail = '';

                if (count > 0) {
                    const first = body.events[0];
                    detail = ' First event: ' + (first.type || '?') + ' from ' + (first.providerId || '?') + '.';
                }
                return 'Event batch with ' + count + ' event' + (count === 1 ? '' : 's') + '.' + detail;
            }
            return 'Unknown payload kind "' + (body.kind || '?') + '".';
        }

        function render() {
            listEl.innerHTML = '';

            if (state.payloads.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'field-help';
                empty.textContent = 'Nothing received yet. Payloads appear here the moment they arrive.';
                listEl.appendChild(empty);
                return;
            }

            state.payloads.slice().reverse().forEach(function (p) {
                const row = document.createElement('details');
                row.className = 'rc-row';

                const head = document.createElement('summary');
                head.textContent = fmtTime(p.receivedAt) + ' – ' + summarize(p) +
                    (p.authPresent ? ' [auth header present]' : ' [no auth header]');
                row.appendChild(head);

                const pre = document.createElement('pre');
                pre.className = 'rc-json';
                pre.textContent = JSON.stringify(p.body, null, 2);
                row.appendChild(pre);
                listEl.appendChild(row);
            });
        }

        // ---- Polling ----------------------------------------------------------

        async function poll() {
            try {
                const response = await fetch(endpointUrl(), {cache: 'no-store'});

                if (!response.ok) {
                    setStatus('The receiver returned HTTP ' + response.status + '. Check the receiver base URL.');
                    return;
                }

                const data = await response.json();
                state.payloads = Array.isArray(data.payloads) ? data.payloads : [];

                if (state.payloads.length === 0) {
                    setStatus('Connected. Waiting for the first payload from your endpoint.');
                } else {
                    setStatus('Received ' + state.payloads.length + ' payload' +
                        (state.payloads.length === 1 ? '' : 's') + '. Last at ' +
                        fmtTime(state.payloads[state.payloads.length - 1].receivedAt) + '.');
                }

                render();
                runChecks();
            } catch {
                setStatus('Could not reach the receiver. Check the base URL and your network.');
            }
        }

        function restartPolling() {
            if (state.timer !== null) {
                clearInterval(state.timer);
            }

            state.timer = setInterval(poll, pollIntervalMs);
            poll();
        }

        // ---- Actions ----------------------------------------------------------

        async function sendSample() {
            const body = {
                kind: 'heartbeat',
                schemaVersion: 1,
                sentAt: Date.now(),
                installed: true,
                enabled: true,
                version: 'sample',
                deviceTag: 'sample-device',
                siteId: 'sample-site',
                proxyOrigin: 'https://api.osprey.ac',
                proxyReachable: true,
            };

            try {
                const response = await fetch(endpointUrl(), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(body),
                });

                setStatus(response.ok ?
                    'Sample sent. It should appear below within a few seconds.' :
                    'The receiver rejected the sample with HTTP ' + response.status + '.');
            } catch {
                setStatus('Could not reach the receiver to send the sample.');
            }
        }

        function startSession() {
            state.token = newToken();
            state.payloads = [];
            refreshUrl();
            render();
            runChecks();
            restartPolling();
        }

        document.getElementById('rc-copy').addEventListener('click', function () {
            navigator.clipboard.writeText(urlInput.value).then(function () {
                setStatus('Test URL copied to the clipboard.');
            });
        });

        document.getElementById('rc-sample').addEventListener('click', sendSample);
        document.getElementById('rc-new').addEventListener('click', startSession);

        baseInput.addEventListener('change', function () {
            refreshUrl();
            restartPolling();
        });

        startSession();
    })();
</script>

<style is:global>
    .rc-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.5rem;
        align-items: start;
        margin-top: 1rem;
    }

    @media (max-width: 900px) {
        .rc-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .gen-group {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background-color: var(--surface);
        padding: 1rem 1.2rem 1.2rem;
        margin: 0 0 1.2rem;
    }

    .rc-heading {
        font-size: 1.05rem;
        margin: 0 0 0.4rem;
    }

    .field {
        display: block;
        margin-top: 0.9rem;
    }

    .field-label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }

    .field-help {
        display: block;
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }

    .text-input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.5rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background-color: var(--bg);
        color: var(--text);
        font-family: inherit;
    }

    .ghost-btn {
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background-color: transparent;
        color: var(--text);
        cursor: pointer;
        font-family: inherit;
    }

    .ghost-btn:hover {
        background-color: var(--surface-hover);
    }

    .rc-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .rc-checks {
        list-style: none;
        margin: 0.6rem 0 0;
        padding: 0;
    }

    .rc-check {
        display: flex;
        gap: 0.6rem;
        align-items: flex-start;
        padding: 0.45rem 0;
        border-top: 1px solid var(--border);
    }

    .rc-check:first-child {
        border-top: none;
    }

    .rc-check-label {
        font-weight: 600;
    }

    .rc-mark {
        display: inline-block;
        width: 1.2rem;
        text-align: center;
        font-weight: 700;
        color: var(--text-muted);
    }

    .rc-pass .rc-mark {
        color: var(--safe);
    }

    .rc-warn .rc-mark {
        color: var(--accent);
    }

    .rc-received {
        margin-top: 0.3rem;
    }

    .rc-row {
        border-top: 1px solid var(--border);
        padding: 0.4rem 0;
    }

    .rc-row:first-child {
        border-top: none;
    }

    .rc-row summary {
        cursor: pointer;
        color: var(--text);
    }

    .rc-json {
        background-color: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.7rem;
        margin: 0.5rem 0 0.3rem;
        overflow-x: auto;
        font-size: 0.8rem;
    }
</style>
